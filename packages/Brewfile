# brew "k9s"             # Kubernetes TUI; add when Kubernetes becomes part of the regular workflow
# brew "rainfrog"        # Database TUI for browsing/querying SQL databases from the terminal
# brew "btop"            # Interactive CPU/memory/process monitor
# gh-dash                 # GitHub PR/issue dashboard TUI; add if `gh` alone becomes cumbersome
# Posting / ATAC          # HTTP API TUI clients; choose one only if terminal API testing becomes frequent
