if [[ -x /opt/homebrew/bin/brew ]]; then
  eval "$(/opt/homebrew/bin/brew shellenv)"
elif [[ -x /home/linuxbrew/.linuxbrew/bin/brew ]]; then
  eval "$(/home/linuxbrew/.linuxbrew/bin/brew shellenv)"
fi

# Load secrets before tmux so the server and directly launched commands inherit project paths.
[ -f ~/.secrets ] && source ~/.secrets

# Enable oh-my-opencode-slim background agents.
export OPENCODE_EXPERIMENTAL_BACKGROUND_SUBAGENTS=true

# Auto-start tmux (only when not already inside tmux, excluding IDE built-in terminals)
if command -v tmux &>/dev/null && [[ -z "$TMUX" ]] && [[ "$TERMINAL_EMULATOR" != "JetBrains-JediTerm" ]]; then
  tmux attach || tmux new -s default
fi

# Local helper binaries (module scripts)
if [ -d "$HOME/.local/bin" ]; then
  case ":$PATH:" in
    *:"$HOME/.local/bin":*) ;;
    *) export PATH="$HOME/.local/bin:$PATH" ;;
  esac
fi

# Cache the brew prefix (brew --prefix is slow, so call it only once)
if command -v brew >/dev/null 2>&1; then
  BREW_PREFIX="$(brew --prefix)"
  # Homebrew completions (must be on fpath before compinit)
  fpath=("$BREW_PREFIX/share/zsh/site-functions" $fpath)
fi

# Completion system (git, etc.) — was provided by oh-my-zsh
autoload -Uz compinit && compinit
zstyle ':completion:*' matcher-list 'm:{a-z}={A-Za-z}'  # case-insensitive matching
zstyle ':completion:*' menu select                      # arrow-key menu selection
zstyle ':completion:*' list-colors "${(s.:.)LS_COLORS}" # color matches like ls

# Command typo correction: correct misspelled commands → "correct 'xyz' to 'abc' [nyae]?" prompt
setopt CORRECT

# Project directory vars come from the private secrets repo, loaded via ~/.secrets

# Preferred editor for local and remote sessions
if [[ -n $SSH_CONNECTION ]]; then
  export EDITOR='vim'
else
  export EDITOR='nvim'
fi

# Modern CLI aliases
if command -v bat &>/dev/null; then alias cat="bat"; fi
if command -v eza &>/dev/null; then alias ls="eza"; fi

# c++ alias
alias g++="g++ -std=c++17"
alias clang++="clang++ -std=c++17"

# mise — one manager for node/ruby/java runtimes (replaced rbenv/jenv/pyenv/nvm).
# Reads ~/.config/mise/config.toml; activate hooks PATH per shell, no shims.
# (Python is on uv, not mise — uv needs no shell init.)
if command -v mise &>/dev/null; then
  eval "$(mise activate zsh)"
fi

# fzf (Ctrl+T file select, Alt+C directory jump; Ctrl+R is replaced by Atuin below)
if command -v fzf &>/dev/null; then
  source <(fzf --zsh)

  # gco — fzf로 로컬/원격 브랜치 골라 checkout
  gco() {
    git checkout "$(git branch --all | grep -v HEAD | fzf | tr -d ' *' | sed 's|remotes/origin/||')"
  }
fi

# Atuin — structured shell history; initialized after fzf so it owns Ctrl+R.
if command -v atuin &>/dev/null; then
  eval "$(atuin init zsh)"
fi

# zoxide (autojump replacement, z/zi commands)
if command -v zoxide &>/dev/null; then
  eval "$(zoxide init zsh)"
fi

# Yazi — `y` opens the file manager and changes the shell cwd to the final Yazi directory.
if command -v yazi &>/dev/null; then
  y() {
    local tmp cwd
    tmp="$(mktemp -t yazi-cwd.XXXXXX)" || return
    yazi "$@" --cwd-file="$tmp"
    IFS= read -r -d '' cwd < <(printf '%s\0' "$(cat -- "$tmp")")
    if [[ -n "$cwd" && "$cwd" != "$PWD" ]]; then
      builtin cd -- "$cwd"
    fi
    rm -f -- "$tmp"
  }
fi

# zsh plugins (installed via brew; replaced oh-my-zsh's plugin loader).
# syntax-highlighting must be sourced last, after all other zle setup.
if [[ -n "$BREW_PREFIX" ]]; then
  source "$BREW_PREFIX/share/zsh-autosuggestions/zsh-autosuggestions.zsh"
  source "$BREW_PREFIX/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh"
fi
