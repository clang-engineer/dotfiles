{
  "$schema": "https://opencode.ai/config.json",
  "model": "openai/gpt-5.6-sol",
  "small_model": "openai/gpt-5.3-codex-spark",
  "default_agent": "build",
  "agent": {
    "build": {
      "description": "복잡한 구현/리팩터링 정밀 모드",
      "prompt": "항상 한국어로만 응답한다",
      "mode": "primary",
      "model": "openai/gpt-5.6-sol",
      "variant": "high",
      "steps": 80
    },
    "plan": {
      "description": "실행 계획과 작업 분할",
      "prompt": "항상 한국어로만 응답한다",
      "mode": "primary",
      "model": "openai/gpt-5.6-sol",
      "variant": "high",
      "steps": 80,
      "permission": {
        "edit": {
          "*": "deny",
          "plans/*.md": "allow"
        },
        "question": "allow",
        "plan_exit": "allow"
      }
    }
  }
}
