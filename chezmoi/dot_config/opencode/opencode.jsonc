{
  "$schema": "https://opencode.ai/config.json",
  "compaction": {
    "auto": true,
    "tail_turns": 2,
    "preserve_recent_tokens": 2000,
    "prune": true
  },
  "tool_output": {
    "max_lines": 140,
    "max_bytes": 4000
  },
  "lsp": true,
  "mcp": {
    "serena": {
      "type": "local",
      "command": [
        "{env:HOME}/.local/bin/serena",
        "start-mcp-server",
        "--context=ide",
        "--project-from-cwd",
        "--mode=no-memories"
      ],
      "enabled": true,
      "timeout": 30000
    },
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true
    }
  }
}
