{
  "$schema": "https://opencode.ai/config.json",
  "compaction": {
    "auto": true,
    "tail_turns": 8,
    "preserve_recent_tokens": 600,
    "prune": true
  },
  "tool_output": {
    "max_lines": 200,
    "max_bytes": 8000
  },
  "mcp": {
    "serena": {
      "type": "local",
      "command": [
        "{env:HOME}/.local/bin/serena",
        "start-mcp-server",
        "--context=ide",
        "--project-from-cwd",
        "--mode=no-memories"
      ],
      "enabled": true,
      "timeout": 30000
    },
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true
    }
  },
  "provider": {
    "github-copilot": {
      "models": {
        "gpt-5.3-codex": {
          "limit": {
            "context": 128000,
            "output": 32000
          }
        }
      }
    }
  }
}
