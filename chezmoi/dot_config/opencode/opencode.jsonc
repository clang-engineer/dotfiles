{
  "$schema": "https://opencode.ai/config.json",
  "model": "openai/gpt-5.3-codex-spark",
  "default_agent": "codex-spark",
  "compaction": {
    "auto": true,
    "tail_turns": 8,
    "preserve_recent_tokens": 600,
    "prune": true
  },
  "tool_output": {
    "max_lines": 200,
    "max_bytes": 8000
  },
  "mcp": {
    "serena": {
      "type": "local",
      "command": [
        "{env:HOME}/.local/bin/serena",
        "start-mcp-server",
        "--context=ide",
        "--project-from-cwd",
        "--mode=no-memories"
      ],
      "enabled": true,
      "timeout": 30000
    },
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true
    }
  },
  "agent": {
    "codex-spark": {
      "description": "코드 작성/수정 기본 실행 에이전트",
      "mode": "primary",
      "model": "openai/gpt-5.3-codex-spark",
      "variant": "low",
      "steps": 64
    },
    "codex-sol-build": {
      "description": "복잡한 구현/리팩터링 정밀 모드",
      "mode": "primary",
      "model": "openai/gpt-5.6-sol",
      "variant": "high",
      "steps": 80
    },
    "codex-sol-plan": {
      "description": "실행 계획과 작업 분할",
      "mode": "primary",
      "model": "openai/gpt-5.6-sol",
      "variant": "high",
      "steps": 80,
      "permission": {
        "edit": { "*": "deny", "plans/*.md": "allow" },
        "question": "allow",
        "plan_exit": "allow"
      }
    },
    "deepseek": {
      "description": "DeepSeek V4 Flash — 경량/빠른 작업",
      "mode": "primary",
      "model": "deepseek/deepseek-v4-flash",
      "variant": "max",
      "steps": 64
    }
  },

  "provider": {
    "github-copilot": {
      "models": {
        "gpt-5.3-codex": {
          "limit": {
            "context": 128000,
            "output": 32000
          }
        }
      }
    },
    "deepseek": {
      "options": {
        "apiKey": "{env:DEEPSEEK_API_KEY}",
        "baseURL": "https://api.deepseek.com"
      },
      "models": {
        "deepseek-v4-flash": {}
      }
    }
  }
}
