{
  "$schema": "https://opencode.ai/config.json",
  "model": "openai/gpt-5.3-codex-spark",
  "default_agent": "codex",
  "compaction": {
    "auto": true,
    "tail_turns": 8,
    "preserve_recent_tokens": 600,
    "prune": true
  },
  "tool_output": {
    "max_lines": 200,
    "max_bytes": 8000
  },
  "mcp": {
    "serena": {
      "type": "local",
      "command": [
        "{env:HOME}/.local/bin/serena",
        "start-mcp-server",
        "--context=ide",
        "--project-from-cwd",
        "--mode=no-memories"
      ],
      "enabled": true,
      "timeout": 30000
    },
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true
    }
  },
  "agent": {
    "codex-lite": {
      "description": "짧은 수정/반복 작업용 초저비용 에이전트",
      "mode": "all",
      "model": "openai/gpt-5.3-codex-spark",
      "variant": "none",
      "steps": 32
    },
    "codex": {
      "description": "코드 작업 기본 운영 에이전트",
      "mode": "all",
      "model": "openai/gpt-5.3-codex-spark",
      "variant": "low",
      "steps": 64
    },
    "codex-heavy": {
      "description": "복잡한 설계/리팩터링에서 정밀도 우선 에이전트",
      "mode": "all",
      "model": "openai/gpt-5.6-sol",
      "variant": "high",
      "steps": 80
    },
    "build": {
      "description": "자동 완성/빌드 중심 보조",
      "mode": "all",
      "model": "openai/gpt-5.3-codex-spark",
      "variant": "low",
      "steps": 80
    },
    "plan": {
      "description": "실행 계획과 작업 분할",
      "mode": "all",
      "model": "openai/gpt-5.3-codex-spark",
      "variant": "low",
      "steps": 40
    },
    "general": {
      "description": "일반 질문/도움 작업",
      "mode": "all",
      "model": "openai/gpt-5.3-codex-spark",
      "variant": "low",
      "steps": 40
    },
    "explore": {
      "description": "탐색, 조사, 검색 중심 작업",
      "mode": "all",
      "model": "openai/gpt-5.3-codex-spark",
      "variant": "none",
      "steps": 40
    }
  },
  "provider": {
    "github-copilot": {
      "models": {
        "gpt-5.3-codex": {
          "limit": {
            "context": 128000,
            "output": 32000
          }
        }
      }
    }
  }
}
