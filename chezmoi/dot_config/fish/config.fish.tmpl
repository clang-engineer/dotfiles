# 비대화형 명령에도 Homebrew와 프로젝트 환경을 전달한다.
if test -x /opt/homebrew/bin/brew
    /opt/homebrew/bin/brew shellenv fish | source
else if test -x /home/linuxbrew/.linuxbrew/bin/brew
    /home/linuxbrew/.linuxbrew/bin/brew shellenv fish | source
end

# 기존 zsh 문법과 private source를 유지하고, 값은 코드로 평가하지 않는다.
if test -f "$HOME/.secrets"
    set -l import_failed 0
    command zsh -f -e -c 'source "$HOME/.secrets" >/dev/null; command env -0' |
        while read --null --local --delimiter '=' name value
            if not string match --quiet --regex '^[A-Za-z_][A-Za-z0-9_]*$' -- "$name"
                set import_failed 1
                continue
            end
            # 자식 셸의 메타데이터와 fish 읽기 전용 변수는 가져오지 않는다.
            switch "$name"
                case PWD SHLVL _ status pipestatus status_generation version FISH_VERSION \
                        fish_pid hostname history last_pid fish_kill_signal fish_killring \
                        fish_terminal_color_theme
                    continue
            end
            if not set --global --export -- "$name" "$value" 2>/dev/null
                set import_failed 1
            end
        end
    set -l import_status $pipestatus
    if test "$import_status[1]" -ne 0
        printf 'fish: ~/.secrets could not be loaded (zsh exit %s).\n' "$import_status[1]" >&2
        return "$import_status[1]"
    end
    if test "$import_failed" -ne 0
        printf 'fish: an exported variable from ~/.secrets could not be imported.\n' >&2
        return 1
    end
end

# 공통 값만 shell.yaml에서 가져오고 실행 로직은 이 셸에 둔다.
if test -d "$HOME/.local/bin"; and not contains -- "$HOME/.local/bin" $PATH
    set --global --export PATH "$HOME/.local/bin" $PATH
end
{{ range $name, $value := .shell.environment }}
set --global --export {{ $name }} '{{ $value | replace "\\" "\\\\" | replace "'" "\\'" }}'
{{ end }}
if test -n "$SSH_CONNECTION"
    set --global --export EDITOR '{{ .shell.editor.remote | replace "\\" "\\\\" | replace "'" "\\'" }}'
else
    set --global --export EDITOR '{{ .shell.editor.local | replace "\\" "\\\\" | replace "'" "\\'" }}'
end

set -l config_home "$HOME/.config"
if test -n "$XDG_CONFIG_HOME"
    set config_home "$XDG_CONFIG_HOME"
end
{{ range $name, $path := .shell.configFiles }}
if test -f "$config_home/{{ $path }}"
    if test -z "${{ $name }}"
        set --global --export {{ $name }} "$config_home/{{ $path }}"
    else
        set --global --export {{ $name }} "${{ $name }}"
    end
end
{{ end }}

# Lazygit merges its native settings with Tinty's generated theme.
if test -z "$LG_CONFIG_FILE"; and test -f "$config_home/tinted-theming/tinty/generated/lazygit.yml"
    set -l lazygit_home "$config_home"
{{ if eq .chezmoi.os "darwin" }}
    if not set -q XDG_CONFIG_HOME; or test -z "$XDG_CONFIG_HOME"
        set lazygit_home "$HOME/Library/Application Support"
    end
{{ end }}
    set -gx LG_CONFIG_FILE "$lazygit_home/lazygit/config.yml,$config_home/tinted-theming/tinty/generated/lazygit.yml"
end

# 프롬프트, 키 바인딩, tmux는 대화형 세션에만 적용한다.
if not status is-interactive
    return
end

# EDITOR와 무관하게 Emacs 편집 모드를 유지한다.
set --global fish_key_bindings fish_default_key_bindings

if command --query tmux; and test -z "$TMUX"; and test "$TERMINAL_EMULATOR" != JetBrains-JediTerm
    command tmux attach; or command tmux new -s default
end
{{ range $name, $command := .shell.aliases }}
if command --query '{{ $command | replace "\\" "\\\\" | replace "'" "\\'" }}'
    alias {{ $name }} '{{ $command | replace "\\" "\\\\" | replace "'" "\\'" }}'
end
{{ end }}
alias g++ 'g++ -std={{ .shell.cppStandard }}'
alias clang++ 'clang++ -std={{ .shell.cppStandard }}'

if command --query mise
    mise activate fish | source
end
if command --query fzf
    if test -f "$config_home/tinted-theming/tinty/generated/fzf.opts"
        set -gx FZF_DEFAULT_OPTS_FILE "$config_home/tinted-theming/tinty/generated/fzf.opts"
    end
{{ $header := printf "%s\n%s" .fzf.ctrlTHeader (get .fzf.ctrlTHeaderByOS .chezmoi.os | default "") | trim }}
{{ $headerAction := printf "start:transform-header:printf '%%b' %s" (printf "%q" $header) }}
{{ $options := printf "%s %s %s %s --bind '%s'" .fzf.ctrlT .fzf.toggleHidden .fzf.toggleIgnored (get .fzf.ctrlTByOS .chezmoi.os | default "") ($headerAction | replace "'" "'\\''") | trim }}
    set -gx FZF_DEFAULT_COMMAND '{{ .fzf.fileCommand | replace "\\" "\\\\" | replace "'" "\\'" }} --strip-cwd-prefix'
    # fd cannot combine --strip-cwd-prefix with an explicit search path.
    set -gx FZF_CTRL_T_COMMAND '{{ .fzf.fileCommand | replace "\\" "\\\\" | replace "'" "\\'" }} . (string unescape -- $dir)'
    set -gx FZF_CTRL_T_OPTS '{{ $options | replace "\\" "\\\\" | replace "'" "\\'" }}'
    fzf --fish | source
    # fzf's native Ctrl+T widget keeps the parsed path in a local variable.
    # Export it for the reload bindings without replacing the widget itself.
    functions -c fzf-file-widget __fzf_file_widget_original
    function fzf-file-widget
        set -l parsed (__fzf_parse_commandline)
        set -lx FZF_FILE_ROOT (string unescape -- $parsed[1])
        __fzf_file_widget_original $argv
    end
end
# fzf 다음에 초기화하여 Ctrl+R을 Atuin에 맡긴다.
if command --query atuin
    atuin init fish | source
end
if command --query zoxide
    zoxide init fish | source
end
if command --query starship
    starship init fish | source
end
