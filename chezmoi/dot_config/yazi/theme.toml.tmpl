{{- $palette := includeTemplate "theme-palette" (dict "root" . "tool" "yazi") | fromJson -}}
# Managed palette only; Yazi keeps its built-in settings, keymaps, icons, and syntax theme.
{{ if gt (len $palette) 0 -}}
#:schema https://yazi-rs.github.io/schemas/theme.json

[app]
overall = { bg = "{{ $palette.background }}" }

[mgr]
cwd = { fg = "{{ $palette.cyan }}" }
find_keyword = { fg = "{{ $palette.yellow }}", bold = true, italic = true, underline = true }
find_position = { fg = "{{ $palette.accent }}", bg = "{{ $palette.background }}", bold = true, italic = true }
symlink_target = { fg = "{{ $palette.muted }}", italic = true }
marker_copied = { fg = "{{ $palette.green }}", bg = "{{ $palette.green }}" }
marker_cut = { fg = "{{ $palette.red }}", bg = "{{ $palette.red }}" }
marker_marked = { fg = "{{ $palette.cyan }}", bg = "{{ $palette.cyan }}" }
marker_selected = { fg = "{{ $palette.yellow }}", bg = "{{ $palette.yellow }}" }
count_copied = { fg = "{{ $palette.background }}", bg = "{{ $palette.green }}" }
count_cut = { fg = "{{ $palette.background }}", bg = "{{ $palette.red }}" }
count_selected = { fg = "{{ $palette.background }}", bg = "{{ $palette.yellow }}" }
border_style = { fg = "{{ $palette.muted }}" }

[indicator]
parent = { fg = "{{ $palette.foreground }}", bg = "{{ $palette.surface }}", reversed = false }
current = { fg = "{{ $palette.background }}", bg = "{{ $palette.accent }}", reversed = false }
preview = { fg = "{{ $palette.foreground }}", bg = "{{ $palette.surface }}", underline = true }

[tabs]
active = { fg = "{{ $palette.background }}", bg = "{{ $palette.accent }}", bold = true }
inactive = { fg = "{{ $palette.foreground }}", bg = "{{ $palette.surface }}" }

[mode]
normal_main = { fg = "{{ $palette.background }}", bg = "{{ $palette.accent }}", bold = true }
normal_alt = { fg = "{{ $palette.accent }}", bg = "{{ $palette.surface }}" }
select_main = { fg = "{{ $palette.background }}", bg = "{{ $palette.yellow }}", bold = true }
select_alt = { fg = "{{ $palette.yellow }}", bg = "{{ $palette.surface }}" }
unset_main = { fg = "{{ $palette.background }}", bg = "{{ $palette.red }}", bold = true }
unset_alt = { fg = "{{ $palette.red }}", bg = "{{ $palette.surface }}" }

[status]
overall = { fg = "{{ $palette.foreground }}", bg = "{{ $palette.background }}" }
perm_type = { fg = "{{ $palette.green }}" }
perm_read = { fg = "{{ $palette.yellow }}" }
perm_write = { fg = "{{ $palette.red }}" }
perm_exec = { fg = "{{ $palette.cyan }}" }
perm_sep = { fg = "{{ $palette.muted }}" }
progress_label = { fg = "{{ $palette.foreground }}", bold = true }
progress_normal = { fg = "{{ $palette.green }}", bg = "{{ $palette.surface }}" }
progress_error = { fg = "{{ $palette.yellow }}", bg = "{{ $palette.red }}" }

[which]
border = { fg = "{{ $palette.accent }}" }
mask = { bg = "{{ $palette.background }}" }
cand = { fg = "{{ $palette.cyan }}" }
rest = { fg = "{{ $palette.muted }}" }
desc = { fg = "{{ $palette.foreground }}" }
separator_style = { fg = "{{ $palette.muted }}" }

[confirm]
border = { fg = "{{ $palette.accent }}" }
title = { fg = "{{ $palette.accent }}" }
body = { fg = "{{ $palette.foreground }}" }
list = { fg = "{{ $palette.foreground }}" }
btn_yes = { fg = "{{ $palette.background }}", bg = "{{ $palette.accent }}", reversed = false }
btn_no = { fg = "{{ $palette.foreground }}", bg = "{{ $palette.surface }}" }

[spot]
border = { fg = "{{ $palette.accent }}" }
title = { fg = "{{ $palette.accent }}" }
tbl_col = { fg = "{{ $palette.accent }}" }
tbl_cell = { fg = "{{ $palette.background }}", bg = "{{ $palette.yellow }}", reversed = false }

[notify]
title_info = { fg = "{{ $palette.green }}" }
title_warn = { fg = "{{ $palette.yellow }}" }
title_error = { fg = "{{ $palette.red }}" }

[pick]
border = { fg = "{{ $palette.accent }}" }
active = { fg = "{{ $palette.accent }}", bold = true }
inactive = { fg = "{{ $palette.foreground }}" }

[input]
border = { fg = "{{ $palette.accent }}" }
title = { fg = "{{ $palette.accent }}" }
value = { fg = "{{ $palette.foreground }}" }
selected = { fg = "{{ $palette.background }}", bg = "{{ $palette.accent }}", reversed = false }

[cmp]
border = { fg = "{{ $palette.accent }}" }
active = { fg = "{{ $palette.background }}", bg = "{{ $palette.accent }}", reversed = false }
inactive = { fg = "{{ $palette.foreground }}" }

[tasks]
border = { fg = "{{ $palette.accent }}" }
title = { fg = "{{ $palette.accent }}" }
hovered = { fg = "{{ $palette.accent }}", bold = true }

[help]
border = { fg = "{{ $palette.accent }}" }
chord = { fg = "{{ $palette.cyan }}" }
action = { fg = "{{ $palette.foreground }}" }
hovered = { fg = "{{ $palette.background }}", bg = "{{ $palette.accent }}", reversed = false, bold = true }

[filetype]
rules = [
  { mime = "**/image/*", fg = "{{ $palette.yellow }}" },
  { mime = "**/{audio,video}/*", fg = "{{ $palette.accent }}" },
  { mime = "**/application/{zip,rar,7z*,tar,gzip,xz,zstd,bzip*,lzma,compress,archive,cpio,arj,xar,ms-cab*}", fg = "{{ $palette.red }}" },
  { mime = "**/application/{pdf,doc,rtf}", fg = "{{ $palette.cyan }}" },
  { mime = "vfs/{absent,stale}", fg = "{{ $palette.muted }}" },
  { url = "*", is = "orphan", fg = "{{ $palette.background }}", bg = "{{ $palette.red }}" },
  { url = "*", is = "exec", fg = "{{ $palette.green }}" },
  { url = "*", is = "dummy", fg = "{{ $palette.background }}", bg = "{{ $palette.red }}" },
  { url = "*/", is = "dummy", fg = "{{ $palette.background }}", bg = "{{ $palette.red }}" },
  { url = "*/", fg = "{{ $palette.accent }}" },
  { url = "*", fg = "{{ $palette.foreground }}" },
]
{{ else -}}
# No palette override: use Yazi's native defaults and terminal colors.
{{ end -}}
