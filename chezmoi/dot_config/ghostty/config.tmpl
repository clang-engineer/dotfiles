{{- $theme := .themes -}}
{{- if ne .themeProfile "custom" -}}
{{- if not (hasKey .themeProfiles .themeProfile) -}}
{{- fail (printf "Unknown theme profile: %s" .themeProfile) -}}
{{- end -}}
{{- $theme = index .themeProfiles .themeProfile -}}
{{- end -}}
# Ghostty — tmux inherits this theme's ANSI colors.
# Choose a shared profile in .chezmoidata/theme-profile.yaml or per-app custom themes in themes.yaml.
# Font changes need a new tab/window.
font-family = "JetBrains Mono"
font-family = "D2Coding"
font-family = "JuliaMono"
font-family = "Symbols Nerd Font Mono"
font-codepoint-map = U+3130-U+318F,U+AC00-U+D7A3=D2Coding
theme = {{ $theme.ghostty }}
scrollback-limit = 10000
