# Ghostty — tmux inherits this theme's ANSI colors.
# Choose themes per app in .chezmoidata/themes.yaml; themes/cyberdream stays available.
# Font changes need a new tab/window.
font-family = "JetBrains Mono"
font-family = "D2Coding"
font-family = "JuliaMono"
font-family = "Symbols Nerd Font Mono"
font-codepoint-map = U+3130-U+318F,U+AC00-U+D7A3=D2Coding
theme = {{ .themes.ghostty }}
scrollback-limit = 10000
