{
  "repositories": [
    {
      "path": "tmux-plugins/tmux-cpu",
      "url": "https://github.com/tmux-plugins/tmux-cpu.git"
    },
    {
      "path": "tmux-plugins/tmux-battery",
      "url": "https://github.com/tmux-plugins/tmux-battery.git"
    },
    {
      "path": "catppuccin/tmux",
      "url": "https://github.com/catppuccin/tmux.git",
      "revision": "v2.3.2"
    },
    {
      "path": "rose-pine/tmux",
      "url": "https://github.com/rose-pine/tmux.git"
    },
    {
      "path": "dracula/tmux",
      "url": "https://github.com/dracula/tmux.git"
    },
    {
      "path": "nordtheme/tmux",
      "url": "https://github.com/nordtheme/tmux.git"
    },
    {
      "path": "egel/tmux-gruvbox",
      "url": "https://github.com/egel/tmux-gruvbox.git"
    },
    {
      "path": "TanglingTreats/tmux-everforest",
      "url": "https://github.com/TanglingTreats/tmux-everforest.git"
    },
    {
      "path": "EdenEast/nightfox.nvim",
      "url": "https://github.com/EdenEast/nightfox.nvim.git"
    },
    {
      "path": "jondavidjohn/tmux-tomorrow-theme",
      "url": "https://github.com/jondavidjohn/tmux-tomorrow-theme.git"
    },
    {
      "path": "janoamaral/tokyo-night-tmux",
      "url": "https://github.com/janoamaral/tokyo-night-tmux.git"
    },
    {
      "path": "Nybkox/tmux-ukiyo",
      "url": "https://github.com/Nybkox/tmux-ukiyo.git"
    }
  ],
  "themes": [
    {
      "schemes": [
        "catppuccin-latte",
        "catppuccin-frappe",
        "catppuccin-macchiato",
        "catppuccin-mocha"
      ],
      "entrypoint": "catppuccin/tmux/catppuccin.tmux",
      "option": "@catppuccin_flavor",
      "variants": {
        "catppuccin-latte": "latte",
        "catppuccin-frappe": "frappe",
        "catppuccin-macchiato": "macchiato",
        "catppuccin-mocha": "mocha"
      },
      "before": [
        "set -g @catppuccin_reset true",
        "set -g @catppuccin_window_status_style \"rounded\""
      ],
      "after": [
        "set -g status-right-length 100",
        "set -g status-left-length 100",
        "set -g status-left \"\"",
        "set -g status-right \"#{E:@catppuccin_status_application}\"",
        "set -agF status-right \"#{E:@catppuccin_status_cpu}\"",
        "set -agF status-right \"#{E:@catppuccin_status_ram}\"",
        "set -ag status-right \"#{E:@catppuccin_status_session}\"",
        "set -ag status-right \"#{E:@catppuccin_status_uptime}\"",
        "set -agF status-right \"#{E:@catppuccin_status_battery}\""
      ],
      "repository": "catppuccin/tmux",
      "dependencies": [
        "tmux-plugins/tmux-cpu",
        "tmux-plugins/tmux-battery"
      ],
      "modules": [
        "tmux-plugins/tmux-cpu/cpu.tmux",
        "tmux-plugins/tmux-battery/battery.tmux"
      ]
    },
    {
      "schemes": [
        "rose-pine",
        "rose-pine-moon",
        "rose-pine-dawn"
      ],
      "entrypoint": "rose-pine/tmux/rose-pine.tmux",
      "option": "@rose_pine_variant",
      "variants": {
        "rose-pine": "main",
        "rose-pine-moon": "moon",
        "rose-pine-dawn": "dawn"
      },
      "repository": "rose-pine/tmux"
    },
    {
      "schemes": [
        "dracula"
      ],
      "entrypoint": "dracula/tmux/dracula.tmux",
      "repository": "dracula/tmux"
    },
    {
      "schemes": [
        "nord"
      ],
      "entrypoint": "nordtheme/tmux/nord.tmux",
      "launcher": "bash",
      "repository": "nordtheme/tmux"
    },
    {
      "schemes": [
        "gruvbox-dark",
        "gruvbox-light"
      ],
      "entrypoint": "egel/tmux-gruvbox/gruvbox-tpm.tmux",
      "option": "@tmux-gruvbox",
      "variants": {
        "gruvbox-dark": "dark256",
        "gruvbox-light": "light256"
      },
      "repository": "egel/tmux-gruvbox"
    },
    {
      "schemes": [
        "everforest",
        "everforest-dark-hard",
        "everforest-dark-medium",
        "everforest-dark-soft",
        "everforest-light-hard",
        "everforest-light-medium",
        "everforest-light-soft"
      ],
      "entrypoint": "TanglingTreats/tmux-everforest/everforest-theme.tmux",
      "option": "@tmux-everforest",
      "variants": {
        "everforest": "dark-medium",
        "everforest-dark-hard": "dark-hard",
        "everforest-dark-medium": "dark-medium",
        "everforest-dark-soft": "dark-soft",
        "everforest-light-hard": "light-hard",
        "everforest-light-medium": "light-medium",
        "everforest-light-soft": "light-soft"
      },
      "repository": "TanglingTreats/tmux-everforest"
    },
    {
      "schemes": [
        "tomorrow",
        "tomorrow-night",
        "tomorrow-night-eighties"
      ],
      "entrypoint": "jondavidjohn/tmux-tomorrow-theme/tomorrow.tmux",
      "option": "@tomorrow_flavour",
      "variants": {
        "tomorrow": "tomorrow",
        "tomorrow-night": "tomorrow-night",
        "tomorrow-night-eighties": "tomorrow-night-eighties"
      },
      "repository": "jondavidjohn/tmux-tomorrow-theme"
    },
    {
      "schemes": [
        "nightfox",
        "carbonfox",
        "dawnfox",
        "dayfox",
        "duskfox",
        "nordfox",
        "terafox"
      ],
      "entrypoint": "EdenEast/nightfox.nvim/extra/%s/%s.tmux",
      "mode": "source",
      "repository": "EdenEast/nightfox.nvim"
    },
    {
      "schemes": [
        "tokyo-night-dark",
        "tokyo-night-terminal-dark"
      ],
      "entrypoint": "janoamaral/tokyo-night-tmux/tokyo-night.tmux",
      "option": "@tokyo-night-tmux_theme",
      "variants": {
        "tokyo-night-dark": "night",
        "tokyo-night-terminal-dark": "night"
      },
      "requiresBash": "4.2",
      "repository": "janoamaral/tokyo-night-tmux"
    },
    {
      "schemes": [
        "tokyo-night-light",
        "tokyo-night-terminal-light"
      ],
      "entrypoint": "janoamaral/tokyo-night-tmux/tokyo-night.tmux",
      "option": "@tokyo-night-tmux_theme",
      "variants": {
        "tokyo-night-light": "day",
        "tokyo-night-terminal-light": "day"
      },
      "requiresBash": "4.2",
      "repository": "janoamaral/tokyo-night-tmux"
    },
    {
      "schemes": [
        "tokyo-night-moon"
      ],
      "entrypoint": "janoamaral/tokyo-night-tmux/tokyo-night.tmux",
      "option": "@tokyo-night-tmux_theme",
      "variants": {
        "tokyo-night-moon": "moon"
      },
      "requiresBash": "4.2",
      "repository": "janoamaral/tokyo-night-tmux"
    },
    {
      "schemes": [
        "tokyo-night-storm",
        "tokyo-night-terminal-storm"
      ],
      "entrypoint": "janoamaral/tokyo-night-tmux/tokyo-night.tmux",
      "option": "@tokyo-night-tmux_theme",
      "variants": {
        "tokyo-night-storm": "storm",
        "tokyo-night-terminal-storm": "storm"
      },
      "requiresBash": "4.2",
      "repository": "janoamaral/tokyo-night-tmux"
    },
    {
      "schemes": [
        "kanagawa"
      ],
      "entrypoint": "Nybkox/tmux-ukiyo/ukiyo.tmux",
      "option": "@ukiyo-theme",
      "variants": {
        "kanagawa": "kanagawa/wave"
      },
      "repository": "Nybkox/tmux-ukiyo"
    },
    {
      "schemes": [
        "kanagawa-dragon"
      ],
      "entrypoint": "Nybkox/tmux-ukiyo/ukiyo.tmux",
      "option": "@ukiyo-theme",
      "variants": {
        "kanagawa-dragon": "kanagawa/dragon"
      },
      "repository": "Nybkox/tmux-ukiyo"
    },
    {
      "schemes": [
        "solarized-dark"
      ],
      "entrypoint": "Nybkox/tmux-ukiyo/ukiyo.tmux",
      "option": "@ukiyo-theme",
      "variants": {
        "solarized-dark": "solarized/dark"
      },
      "repository": "Nybkox/tmux-ukiyo"
    },
    {
      "schemes": [
        "solarized-light"
      ],
      "entrypoint": "Nybkox/tmux-ukiyo/ukiyo.tmux",
      "option": "@ukiyo-theme",
      "variants": {
        "solarized-light": "solarized/light"
      },
      "repository": "Nybkox/tmux-ukiyo"
    },
    {
      "schemes": [
        "onedark",
        "one-dark"
      ],
      "entrypoint": "Nybkox/tmux-ukiyo/ukiyo.tmux",
      "option": "@ukiyo-theme",
      "variants": {
        "onedark": "onedark/dark",
        "one-dark": "onedark/dark"
      },
      "repository": "Nybkox/tmux-ukiyo"
    }
  ]
}
