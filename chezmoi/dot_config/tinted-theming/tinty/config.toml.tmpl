# Official Tinted integrations; run tinty sync before the first tinty apply.
default-scheme = "base16-dracula"

# Indirect integrations: terminal palette inheritance (no hooks).
# bat and OpenCode: native theme selection via chezmoi.
# Atuin and eza: default ANSI colors.
# Pi: native system theme.

[[items]]
name = "tinted-vim"
path = "https://github.com/tinted-theming/tinted-vim"
themes-dir = "colors"
supported-systems = ["base16", "base24"]
hook = '''
root="${XDG_CONFIG_HOME:-$HOME/.config}/${NVIM_APPNAME:-nvim}"
dir="$root/colors"
mkdir -p "$dir" || exit 1
tmp=$(mktemp "$dir/.tinted-theming.XXXXXX") || exit 1
cp "$TINTY_THEME_FILE_PATH" "$tmp" && mv -f "$tmp" "$dir/tinted-theming.vim" || { rm -f "$tmp"; exit 1; }
'''

[[items]]
name = "tinted-terminal"
path = "https://github.com/tinted-theming/tinted-terminal"
themes-dir = "themes/ghostty"
supported-systems = ["base16", "base24"]
hook = '''
dir="${XDG_CONFIG_HOME:-$HOME/.config}/ghostty/themes"
mkdir -p "$dir" && cp -f "$TINTY_THEME_FILE_PATH" "$dir/tinted-theming" || exit
# Ghostty reloads its live surfaces on SIGUSR2 (official Tinted integration).
if pgrep -u "$(id -u)" -x ghostty >/dev/null; then
    pkill -USR2 -u "$(id -u)" -x ghostty
fi
'''

[[items]]
name = "tinted-tmux"
path = "https://github.com/tinted-theming/tinted-tmux"
themes-dir = "colors"
supported-systems = ["base16", "base24"]
hook = '''
"$HOME/.local/bin/tinty-tmux-theme"
'''

[[items]]
name = "tinted-fzf"
path = "https://github.com/tinted-theming/tinted-fzf"
themes-dir = "sh"
supported-systems = ["base16", "base24"]
hook = '''
dir="${XDG_CONFIG_HOME:-$HOME/.config}/tinted-theming/tinty/generated"
mkdir -p "$dir" || exit
# Evaluate the official POSIX template here, not in an interactive shell.
FZF_DEFAULT_OPTS=
. "$TINTY_THEME_FILE_PATH"
printf "%s\n" "$FZF_DEFAULT_OPTS" > "$dir/fzf.opts"
'''

[[items]]
name = "tinted-yazi"
path = "https://github.com/tinted-theming/tinted-yazi"
themes-dir = "flavors"
hook = '''
dir="${YAZI_CONFIG_HOME:-${XDG_CONFIG_HOME:-$HOME/.config}/yazi}/flavors/tinted-scheme.yazi"
mkdir -p "$dir" && cp -f "$TINTY_THEME_FILE_PATH" "$dir/flavor.toml" || exit
'''

[[items]]
name = "tinted-delta"
path = "https://github.com/tinted-theming/tinted-delta"
themes-dir = "configs"
supported-systems = ["base16", "base24"]
hook = '''
dir="${XDG_CONFIG_HOME:-$HOME/.config}/delta"
mkdir -p "$dir" && cp -f "$TINTY_THEME_FILE_PATH" "$dir/theme.gitconfig"
'''

[[items]]
name = "tinted-lazygit"
path = "https://github.com/tinted-theming/tinted-lazygit"
themes-dir = "themes"
hook = '''
dir="${XDG_CONFIG_HOME:-$HOME/.config}/tinted-theming/tinty/generated"
mkdir -p "$dir" && cp -f "$TINTY_THEME_FILE_PATH" "$dir/lazygit.yml"
'''
