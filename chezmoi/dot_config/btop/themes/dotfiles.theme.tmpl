{{- $p := includeTemplate "theme-palette" (dict "root" . "tool" "btop") | fromJson -}}
{{- if $p -}}
# Palette adapter for the selected dotfiles profile.
theme[main_bg]="{{ $p.background }}"
theme[main_fg]="{{ $p.foreground }}"
theme[title]="{{ $p.foreground }}"
theme[hi_fg]="{{ $p.accent }}"
theme[selected_bg]="{{ $p.surface }}"
theme[selected_fg]="{{ $p.foreground }}"
theme[inactive_fg]="{{ $p.muted }}"
theme[graph_text]="{{ $p.foreground }}"
theme[meter_bg]="{{ $p.background }}"
theme[proc_misc]="{{ $p.accent }}"
theme[cpu_box]="{{ $p.accent }}"
theme[mem_box]="{{ $p.green }}"
theme[net_box]="{{ $p.red }}"
theme[proc_box]="{{ $p.cyan }}"
theme[div_line]="{{ $p.muted }}"
{{ range $name := list "temp" "cpu" "free" "cached" "available" "used" "download" "upload" "process" -}}
theme[{{ $name }}_start]="{{ $p.cyan }}"
theme[{{ $name }}_mid]="{{ $p.green }}"
theme[{{ $name }}_end]="{{ $p.red }}"
{{ end -}}
{{ end -}}
