{{- $p := includeTemplate "theme-palette" (dict "root" . "tool" "eza") | fromJson -}}
{{- if $p -}}
# Native eza theme; environment color overrides still take precedence.
filekinds:
  normal: {foreground: '{{ $p.foreground }}'}
  directory: {foreground: '{{ $p.cyan }}', is_bold: true}
  symlink: {foreground: '{{ $p.accent }}'}
  pipe: {foreground: '{{ $p.yellow }}'}
  socket: {foreground: '{{ $p.red }}'}
  executable: {foreground: '{{ $p.green }}', is_bold: true}
  special: {foreground: '{{ $p.yellow }}'}
perms:
  user_read: {foreground: '{{ $p.green }}'}
  user_write: {foreground: '{{ $p.yellow }}'}
  user_execute_file: {foreground: '{{ $p.red }}'}
  user_execute_other: {foreground: '{{ $p.red }}'}
git:
  new: {foreground: '{{ $p.green }}'}
  modified: {foreground: '{{ $p.yellow }}'}
  deleted: {foreground: '{{ $p.red }}'}
  renamed: {foreground: '{{ $p.cyan }}'}
  conflicted: {foreground: '{{ $p.red }}', is_bold: true}
date: {foreground: '{{ $p.cyan }}'}
header: {foreground: '{{ $p.accent }}', is_bold: true}
broken_symlink: {foreground: '{{ $p.red }}'}
{{ end -}}
