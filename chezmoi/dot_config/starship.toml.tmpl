"$schema" = 'https://starship.rs/config-schema.json'

# Select the active palette in .chezmoidata/themes.yaml.
palette = {{ .themes.starship | quote }}
add_newline = false
format = '$directory$git_branch$git_status$java$nodejs$character'

[palettes.rose-pine-moon]
cyan = '#9ccfd8'
blue = '#3e8fb0'
purple = '#c4a7e7'
yellow = '#f6c177'
green = '#95b1ac'
red = '#eb6f92'

[palettes.cyberdream]
cyan = '#5ef1ff'
blue = '#5ea1ff'
purple = '#bd5eff'
yellow = '#f1ff5e'
green = '#5eff6c'
red = '#ff6e5e'

# Official palette: https://github.com/dracula/starship/blob/920e9f46ccc25beee15ed7fe0baddabdfeaaf92a/starship.toml
# MIT license: starship.dracula.LICENSE
[palettes.dracula]
background = '#282a36'
current_line = '#44475a'
foreground = '#f8f8f2'
comment = '#6272a4'
cyan = '#8be9fd'
green = '#50fa7b'
orange = '#ffb86c'
pink = '#ff79c6'
purple = '#bd93f9'
red = '#ff5555'
yellow = '#f1fa8c'
# Dracula uses purple for ANSI blue; keep existing module styles unchanged.
blue = '#bd93f9'

[directory]
style = 'bold cyan'
format = '[$path]($style) '

[git_branch]
style = 'bold purple'
format = '[ $branch]($style) '

[git_status]
style = 'yellow'
format = '([\[$all_status$ahead_behind\]]($style) )'

[java]
style = 'green'
format = '[$symbol$version]($style) '

[nodejs]
style = 'blue'
format = '[$symbol$version]($style) '

[character]
success_symbol = '[❯](bold cyan)'
error_symbol = '[❯](bold red)'
vimcmd_symbol = '[❮](bold purple)'
