{{- /* chezmoi:modify-template */ -}}
{{- $config := .chezmoi.stdin -}}
{{- if regexMatch `(?m)^[ \t]*--theme(?:[= \t])` $config -}}
{{ regexReplaceAll `(?m)^([ \t]*--theme[ \t]*=?[ \t]*)"?Dracula"?([ \t]*(?:#.*)?)$` $config `${1}"base16-256"${2}` -}}
{{- else -}}
{{- $config -}}
{{- if and $config (not (hasSuffix "\n" $config)) }}
{{ end -}}
--theme="base16-256"
{{- end -}}
