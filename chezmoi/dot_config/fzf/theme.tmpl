{{- $theme := includeTemplate "theme-resolve" . | fromJson -}}
{{- if eq $theme.fzf "shared" -}}
{{- $c := $theme.sharedColours -}}
{{/* Adapted from the shared profile's Oh my tmux! palette. Keep comments template-only: Fish joins these lines before appending picker options. */ -}}
--color=fg:{{ index $c 2 }},bg:{{ index $c 0 }},hl:{{ index $c 9 }}
--color=fg+:{{ index $c 2 }},bg+:{{ index $c 0 }},hl+:{{ index $c 9 }}
--color=info:{{ index $c 4 }},prompt:{{ index $c 10 }},pointer:{{ index $c 9 }}
--color=marker:{{ index $c 10 }},spinner:{{ index $c 4 }},header:{{ index $c 3 }}
{{ else -}}
{{ include (printf "dot_config/%s" $theme.fzf) -}}
{{ end -}}
