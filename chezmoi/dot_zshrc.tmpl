if [[ -x /opt/homebrew/bin/brew ]]; then
  eval "$(/opt/homebrew/bin/brew shellenv)"
elif [[ -x /home/linuxbrew/.linuxbrew/bin/brew ]]; then
  eval "$(/home/linuxbrew/.linuxbrew/bin/brew shellenv)"
fi

# Load secrets before tmux so the server and directly launched commands inherit project paths.
[ -f ~/.secrets ] && source ~/.secrets

# 공통 값만 shell.yaml에서 가져오고 실행 로직은 이 셸에 둔다.
if [ -d "$HOME/.local/bin" ]; then
  case ":$PATH:" in
    *:"$HOME/.local/bin":*) ;;
    *) export PATH="$HOME/.local/bin:$PATH" ;;
  esac
fi
{{ range $name, $value := .shell.environment }}
export {{ $name }}='{{ $value | replace "'" "'\\''" }}'
{{ end }}
if [[ -n $SSH_CONNECTION ]]; then
  export EDITOR='{{ .shell.editor.remote | replace "'" "'\\''" }}'
else
  export EDITOR='{{ .shell.editor.local | replace "'" "'\\''" }}'
fi

if [[ -f "${XDG_CONFIG_HOME:-$HOME/.config}/{{ .shell.configFiles.HARLEQUIN_CONFIG_PATH }}" ]]; then
  export HARLEQUIN_CONFIG_PATH="${HARLEQUIN_CONFIG_PATH:-${XDG_CONFIG_HOME:-$HOME/.config}/{{ .shell.configFiles.HARLEQUIN_CONFIG_PATH }}}"
fi
if [[ -f "${XDG_CONFIG_HOME:-$HOME/.config}/{{ .shell.configFiles.VERTICAINI }}" ]]; then
  export VERTICAINI="${VERTICAINI:-${XDG_CONFIG_HOME:-$HOME/.config}/{{ .shell.configFiles.VERTICAINI }}}"
fi

# env_unset [FILE]: clear file-listed variables, or select a .env* file with fzf.
if [[ -r "${XDG_CONFIG_HOME:-$HOME/.config}/shell/env_unset.sh" ]]; then
  source "${XDG_CONFIG_HOME:-$HOME/.config}/shell/env_unset.sh"
fi

# Cache the brew prefix (brew --prefix is slow, so call it only once)
if command -v brew >/dev/null 2>&1; then
  BREW_PREFIX="$(brew --prefix)"
  # Homebrew completions (must be on fpath before compinit)
  fpath=("$BREW_PREFIX/share/zsh/site-functions" $fpath)
fi

# Keep shell editing in Emacs mode even when EDITOR/VISUAL selects Vim.
bindkey -e

# Shell completion
autoload -Uz compinit && compinit
zstyle ':completion:*' matcher-list 'm:{a-z}={A-Za-z}'  # case-insensitive matching
zstyle ':completion:*' menu select                      # arrow-key menu selection
zstyle ':completion:*' list-colors "${(s.:.)LS_COLORS}" # color matches like ls

# Generated Harlequin config and native profile completion.
if command -v harlequin-config &>/dev/null; then
  eval "$(harlequin-config init zsh)"
fi

if command -v tmux &>/dev/null && [[ -z "$TMUX" && "$TERMINAL_EMULATOR" != JetBrains-JediTerm ]]; then
  command tmux attach || command tmux new -s default
fi
{{ range $name, $command := .shell.aliases }}
if command -v '{{ $command | replace "'" "'\\''" }}' &>/dev/null; then
  alias {{ $name }}='{{ $command | replace "'" "'\\''" }}'
fi
{{ end }}
alias g++='g++ -std={{ .shell.cppStandard }}'
alias clang++='clang++ -std={{ .shell.cppStandard }}'

if command -v mise &>/dev/null; then
  eval "$(mise activate zsh)"
fi
if command -v fzf &>/dev/null; then
  export FZF_DEFAULT_OPTS_FILE="${XDG_CONFIG_HOME:-$HOME/.config}/themeset/fzf.opts"
{{ $header := printf "%s\n%s" .fzf.ctrlTHeader (get .fzf.ctrlTHeaderByOS .chezmoi.os | default "") | trim }}
{{ $options := printf "%s %s %s %s --header '%s'" .fzf.ctrlT .fzf.toggleHidden .fzf.toggleIgnored (get .fzf.ctrlTByOS .chezmoi.os | default "") ($header | replace "'" "'\\''") | trim }}
  export FZF_DEFAULT_COMMAND='{{ .fzf.fileCommand | replace "'" "'\\''" }} --strip-cwd-prefix'
  export FZF_CTRL_T_COMMAND="$FZF_DEFAULT_COMMAND"
  export FZF_CTRL_T_OPTS='{{ $options | replace "'" "'\\''" }}'
  source <(fzf --zsh)
fi
if command -v rg.fzf &>/dev/null; then
  _rg_fzf_widget() {
    emulate -L zsh
    local output item selected=''
    output="$(command rg.fzf --print0)"
    for item in "${(@0)output}"; do
      [[ -z $item ]] && continue
      selected+="${(q)item} "
    done
    # LBUFFER inserts at the native character cursor without touching RBUFFER.
    [[ -n $selected ]] && LBUFFER+="$selected"
    zle reset-prompt
  }
  zle -N _rg_fzf_widget
  bindkey '^F' _rg_fzf_widget
fi
# fzf 다음에 초기화하여 Ctrl+R을 Atuin에 맡긴다.
if command -v atuin &>/dev/null; then
  eval "$(atuin init zsh)"
fi
if command -v zoxide &>/dev/null; then
  eval "$(zoxide init zsh)"
fi
if command -v starship &>/dev/null; then
  eval "$(starship init zsh)"
fi

# Brew-installed zsh plugins.
# syntax-highlighting must be sourced last, after all other zle setup.
if [[ -n "$BREW_PREFIX" ]]; then
  if command -v fzf &>/dev/null && [[ -r "$BREW_PREFIX/opt/fzf-tab/share/fzf-tab/fzf-tab.zsh" ]]; then
    # Keep other commands on their existing completion UI.
    zstyle ':fzf-tab:*' disabled-on any
    zstyle ':fzf-tab:complete:harlequin:*' disabled-on none
    zstyle ':completion:*:harlequin:*' menu no
    source "$BREW_PREFIX/opt/fzf-tab/share/fzf-tab/fzf-tab.zsh"
  fi
  [[ -f "$BREW_PREFIX/share/zsh-autosuggestions/zsh-autosuggestions.zsh" ]] \
    && source "$BREW_PREFIX/share/zsh-autosuggestions/zsh-autosuggestions.zsh"
  [[ -f "$BREW_PREFIX/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh" ]] \
    && source "$BREW_PREFIX/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh"
fi
