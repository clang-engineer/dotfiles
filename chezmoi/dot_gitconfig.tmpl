[core]
	autocrlf = input
	hooksPath = ~/.config/git/hooks
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
# Identity ([user] name/email) is set per-machine in ~/.gitconfig.local
# (gitignored), created by chezmoi/create_dot_gitconfig.local.tmpl at init.
[include]
	path = {{ .chezmoi.homeDir }}/.gitconfig.local
	path = {{ .chezmoi.homeDir }}/.config/delta/dracula/dracula.gitconfig
[core]
	pager = delta
[interactive]
	diffFilter = delta --color-only
[delta]
	navigate = true
	line-numbers = true
	side-by-side = false
	syntax-theme = {{ .themes.delta.syntax }}
	features = {{ .themes.delta.feature }}
[merge]
	conflictStyle = zdiff3
