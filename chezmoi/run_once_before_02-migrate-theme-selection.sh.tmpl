#!/bin/sh
# Preserve the old native selection before chezmoi removes its obsolete data file.
set -eu
IFS= read -r home <<'THEMESET_HOME'
{{ .chezmoi.homeDir }}
THEMESET_HOME
legacy="$home/.config/dotfiles/theme.lua"
target="$home/.config/themeset/neovim.lua"
if [ ! -f "$legacy" ] || [ -e "$target" ] || [ -L "$target" ]; then
  exit 0
fi
mkdir -p "${target%/*}"
temporary=$(mktemp "$target.XXXXXX")
trap 'rm -f "$temporary"' EXIT HUP INT TERM
{
  cat <<'LUA'
-- Managed by themeset: selects an existing installed colorscheme.
-- One-time migration of the previously selected native colorscheme.
local function apply()
  local ok, err = pcall(function()
    local name, contrast = (function()
LUA
  cat "$legacy"
  cat <<'LUA'
    end)()
    if name == "gruvbox" then
      require("gruvbox").setup({ contrast = contrast or "", transparent_mode = false })
    end
    vim.cmd.colorscheme(name)
  end)
  if not ok then
    vim.notify("themeset: " .. tostring(err), vim.log.levels.ERROR)
  end
end
if vim.v.vim_did_enter == 1 then
  apply()
else
  vim.api.nvim_create_autocmd("VimEnter", { once = true, callback = function()
    vim.schedule(apply)
  end })
end
LUA
} >"$temporary"
chmod 600 "$temporary"
mv "$temporary" "$target"
trap - EXIT HUP INT TERM
