{{- if not (kindIs "slice" .themeTargets) -}}
{{- fail "themeTargets must be a list (use [] for no shared targets)" -}}
{{- end -}}
{{- $supported := list "ghostty" "neovim" "tmux" "starship" "fzf" "yazi" "atuin" "lazygit" "lazydocker" "btop" "eza" -}}
{{- range .themeTargets -}}
{{- if not (has . $supported) -}}
{{- fail (printf "Unsupported theme target: %v (supported: %s)" . (join ", " $supported)) -}}
{{- end -}}
{{- end -}}
{{- $theme := deepCopy .themes -}}
{{- if ne .themeProfile "custom" -}}
{{- if not (hasKey .themeProfiles .themeProfile) -}}
{{- fail (printf "Unknown theme profile: %s" .themeProfile) -}}
{{- end -}}
{{- $profile := index .themeProfiles .themeProfile -}}
{{- range $tool := .themeTargets -}}
{{- if has $tool (list "starship" "fzf" "yazi" "atuin" "lazygit" "lazydocker" "btop" "eza") -}}
{{- $_ := set $theme $tool "shared" -}}
{{- $_ := set $theme "sharedColours" $profile.tmux.colours -}}
{{- else -}}
{{- $_ := set $theme $tool (index $profile $tool) -}}
{{- if eq $tool "neovim" -}}
{{- $_ := set $theme "gruvboxContrast" (get $profile "gruvboxContrast") -}}
{{- end -}}
{{- end -}}
{{- end -}}
{{- end -}}
{{- $theme | toJson -}}
