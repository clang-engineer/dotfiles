{{- $palette := includeTemplate "theme-palette" (dict "root" . "tool" "lazydocker") | fromJson -}}
{{ if $palette -}}
gui:
  theme:
    activeBorderColor: [{{ $palette.accent | quote }}, bold]
    inactiveBorderColor: [{{ $palette.foreground | quote }}]
    selectedLineBgColor: [{{ $palette.surface | quote }}]
    optionsTextColor: [{{ $palette.cyan | quote }}]
{{ else -}}
{}
{{ end -}}
