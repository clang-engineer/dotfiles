{{- $root := .root -}}
{{- $theme := includeTemplate "theme-resolve" $root | fromJson -}}
{{- $choice := index $theme .tool -}}
{{- $palette := dict -}}
{{- if ne $choice "terminal" -}}
{{- $c := list -}}
{{- if eq $choice "shared" -}}
{{- $c = $theme.sharedColours -}}
{{- else -}}
{{- if not (hasKey $root.themeProfiles $choice) -}}
{{- fail (printf "Unknown %s palette: %v (use terminal or a shared profile name)" .tool $choice) -}}
{{- end -}}
{{- $c = (index $root.themeProfiles $choice).tmux.colours -}}
{{- end -}}
{{- /* The tmux surface slot can equal foreground in high-contrast profiles.
     Blend a distinct surface and muted text from the actual background/foreground. */ -}}
{{- $surface := "#" -}}
{{- $muted := "#" -}}
{{- range $start := list 1 3 5 -}}
{{- $end := int (add $start 2) -}}
{{- $bg := int (printf "0x%s" (substr $start $end (index $c 0))) -}}
{{- $fg := int (printf "0x%s" (substr $start $end (index $c 2))) -}}
{{- $surface = printf "%s%02x" $surface (div (add (mul $bg 9) $fg) 10) -}}
{{- $muted = printf "%s%02x" $muted (div (add $bg $fg) 2) -}}
{{- end -}}
{{- $palette = dict "background" (index $c 0) "foreground" (index $c 2) "surface" $surface "accent" (index $c 9) "cyan" (index $c 3) "yellow" (index $c 4) "green" (index $c 10) "red" (index $c 15) "muted" $muted -}}
{{- end -}}
{{- $palette | toJson -}}
