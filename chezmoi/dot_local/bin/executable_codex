#!/bin/sh

set -eu

resolve_real_command() {
  local_name="codex"

  wrapper_path="$0"
  case "$wrapper_path" in
    */*) ;;
    *) wrapper_path="$(command -v "$0" 2>/dev/null || printf '%s' "$0")" ;;
  esac

  # Remove empty PATH segments for robust handling (portable fallback).
  case "$wrapper_path" in
    /*) wrapper_dir="${wrapper_path%/*}" ;;
    *) wrapper_dir="$(pwd)" ;;
  esac

  IFS=':'
  for path_entry in $PATH; do
    [ -z "$path_entry" ] && path_entry='.'

    candidate="$path_entry/$local_name"
    if [ "$candidate" = "$wrapper_path" ] || [ "$candidate" = "$wrapper_dir/$local_name" ]; then
      continue
    fi

    if [ -x "$candidate" ]; then
      echo "$candidate"
      return 0
    fi
  done

  return 1
}

REAL_BIN="$(resolve_real_command || true)"
if [ -z "$REAL_BIN" ]; then
  echo "codex: unable to locate underlying binary" >&2
  exit 1
fi

has_developer_override=0
next_is_config=0

for arg in "$@"; do
  if [ "$next_is_config" -eq 1 ]; then
    case "$arg" in
      developer_instructions=*)
        has_developer_override=1
        ;;
    esac
    next_is_config=0
    continue
  fi

  case "$arg" in
    -c|--config)
      next_is_config=1
      ;;
    -c=*|--config=*)
      case "$arg" in
        -c=developer_instructions=*|--config=developer_instructions=*)
          has_developer_override=1
          ;;
      esac
      ;;
  esac
done

if [ "$has_developer_override" -eq 0 ]; then
  set -- -c 'developer_instructions="항상 한국어로만 응답한다"' "$@"
fi

exec "$REAL_BIN" "$@"
