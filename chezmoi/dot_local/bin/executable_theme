#!/bin/sh
# 도구별 설정은 chezmoi가 렌더링하고, 이 명령은 공통 프로필만 선택한다.
set -eu

usage() {
  printf '%s\n' 'Usage: theme list | show | set PROFILE'
}

command -v chezmoi >/dev/null 2>&1 || {
  printf '%s\n' 'theme: chezmoi is required' >&2
  exit 1
}

case "${1:-}" in
  list)
    [ "$#" -eq 1 ] || {
      usage >&2
      exit 2
    }
    chezmoi execute-template '{{ range keys .themeProfiles | sortAlpha }}{{ . }}{{ "\n" }}{{ end }}custom{{ "\n" }}'
    exit
    ;;
  show)
    [ "$#" -eq 1 ] || {
      usage >&2
      exit 2
    }
    chezmoi execute-template '{{ .themeProfile }}{{ "\n" }}'
    exit
    ;;
  set)
    [ "$#" -eq 2 ] || {
      usage >&2
      exit 2
    }
    ;;
  -h | --help)
    usage
    exit
    ;;
  *)
    usage >&2
    exit 2
    ;;
esac

profile=$2
profiles=$(chezmoi execute-template '{{ range keys .themeProfiles | sortAlpha }}{{ . }}{{ "\n" }}{{ end }}custom')
valid=false
for candidate in $profiles; do
  if [ "$profile" = "$candidate" ]; then
    valid=true
    break
  fi
done
if [ "$valid" != true ]; then
  printf 'theme: unknown profile: %s (see theme list)\n' "$profile" >&2
  exit 2
fi

source_dir=$(chezmoi execute-template '{{ .chezmoi.sourceDir }}')
destination=$(chezmoi execute-template '{{ .chezmoi.destDir }}')
selection="$source_dir/.chezmoidata/theme-profile.yaml"
# 설치나 다른 dotfiles 변경 없이 세 설정만 검사하고 적용한다.
set -- "$destination/.config/ghostty/config" \
  "$destination/.config/dotfiles/theme.lua" "$destination/.tmux.conf.local"
override=$(printf '{"themeProfile":"%s"}' "$profile")
chezmoi --override-data "$override" cat "$@" >/dev/null

temporary=$(mktemp "$selection.XXXXXX")
trap 'rm -f "$temporary"' EXIT HUP INT TERM
printf 'themeProfile: %s\n' "$profile" >"$temporary"
mv "$temporary" "$selection"
trap - EXIT HUP INT TERM
# 실패 시 선택값은 유지된다. 충돌을 해결한 뒤 같은 명령으로 다시 적용한다.
chezmoi --no-tty --error-on-conflict apply --exclude scripts "$@"
printf 'Selected %s for Ghostty, Neovim and tmux.\n' "$profile"

reload_failed=false
if command -v tmux >/dev/null 2>&1 && tmux has-session 2>/dev/null; then
  if [ -f "$destination/.tmux.conf" ]; then
    # Oh my tmux!의 테마 단계만 실행하여 플러그인 업데이트를 유발하지 않는다.
    # TMUX_CONF는 호출 셸이 아니라 tmux 서버의 run-shell 환경에서 확장한다.
    # shellcheck disable=SC2016
    if ! tmux source-file "$destination/.tmux.conf.local" \; \
      run-shell 'cut -c3- "$TMUX_CONF" | sh -s _apply_theme'; then
      printf '%s\n' 'theme: tmux reload failed; configuration files were updated' >&2
      reload_failed=true
    fi
  else
    printf '%s\n' 'theme: tmux is running but ~/.tmux.conf is missing; reload it manually' >&2
    reload_failed=true
  fi
fi

case "$(uname -s)" in
  Darwin)
    # Ghostty의 기본 AppleScript API를 사용한다. 키 입력/접근성 권한은 불필요하다.
    if pgrep -x ghostty >/dev/null 2>&1 || pgrep -x Ghostty >/dev/null 2>&1; then
      if ! osascript <<'APPLESCRIPT'
with timeout of 10 seconds
  tell application id "com.mitchellh.ghostty"
    if (count of terminals) > 0 then
      if not (perform action "reload_config" on first terminal) then error "Ghostty rejected reload_config"
    end if
  end tell
end timeout
APPLESCRIPT
      then
        printf '%s\n' 'theme: Ghostty reload failed; press Cmd+Shift+, to reload configuration' >&2
        reload_failed=true
      fi
    fi
    ;;
  *)
    if command -v ghostty >/dev/null 2>&1 && pgrep -x ghostty >/dev/null 2>&1; then
      if ! pkill -USR2 -x ghostty; then
        printf '%s\n' 'theme: Ghostty reload failed; press Ctrl+Shift+, to reload configuration' >&2
        reload_failed=true
      fi
    fi
    ;;
esac

printf '%s\n' 'Open Neovim instances reload through the theme watcher after this integration is loaded.'
[ "$reload_failed" = false ]
