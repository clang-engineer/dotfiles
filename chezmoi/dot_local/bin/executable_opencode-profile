#!/bin/sh

set -eu

usage() {
  cat <<'EOF'
Usage:
  opencode-profile [eco|pro]
  opencode-profile --list

  eco: low-cost profile
  pro: high-quality profile
  --list: show available profiles
EOF
}

if [ "$#" -eq 0 ]; then
  usage
  exit 1
fi

BASE_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/opencode"
TARGET="$BASE_DIR/opencode.jsonc"

if [ "$1" = "--list" ]; then
  if cmp -s "$TARGET" "$BASE_DIR/opencode-eco.jsonc"; then
    printf "* eco: low-cost (active)\n"
  else
    printf "  eco: low-cost\n"
  fi

  if cmp -s "$TARGET" "$BASE_DIR/opencode-pro.jsonc"; then
    printf "* pro: high-quality (active)\n"
  else
    printf "  pro: high-quality\n"
  fi

  if [ ! -f "$TARGET" ] || {
    ! cmp -s "$TARGET" "$BASE_DIR/opencode-eco.jsonc" && ! cmp -s "$TARGET" "$BASE_DIR/opencode-pro.jsonc"
  }; then
    printf "  custom: current config differs from eco/pro\n"
  fi
  exit 0
fi

case "$1" in
  eco|pro)
    PROFILE="$1"
    ;;
  -h|--help)
    usage
    exit 0
    ;;
  *)
    echo "opencode-profile: unknown profile '$1'" >&2
    usage
    exit 1
    ;;
esac

SRC="$BASE_DIR/opencode-${PROFILE}.jsonc"

if [ ! -f "$SRC" ]; then
  echo "opencode-profile: profile file not found: $SRC" >&2
  exit 1
fi

cp "$SRC" "$TARGET"
echo "Applied opencode profile '$PROFILE'"
