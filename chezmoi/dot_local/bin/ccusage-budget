#!/bin/sh

set -eu

usage() {
  cat <<'EOF'
Usage:
  ccusage-budget [--days N] [--warn COST] [--critical COST] [--service opencode]

  --days: Days to look back (default: 7)
  --warn: Warning threshold for totalCost (default: 100)
  --critical: Critical threshold for totalCost (default: 200)
  --service: Service name for ccusage (default: opencode)
EOF
}

DAYS=7
WARN=100
CRITICAL=200
SERVICE="opencode"

while [ "$#" -gt 0 ]; do
  case "$1" in
    --days)
      DAYS="$2"
      shift 2
      ;;
    --warn)
      WARN="$2"
      shift 2
      ;;
    --critical)
      CRITICAL="$2"
      shift 2
      ;;
    --service)
      SERVICE="$2"
      shift 2
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      echo "ccusage-budget: unknown option '$1'" >&2
      usage
      exit 1
      ;;
  esac
done

if ! command -v ccusage >/dev/null 2>&1; then
  echo "ccusage not found. Install ccusage first." >&2
  exit 1
fi

if ! command -v jq >/dev/null 2>&1; then
  echo "jq not found. Install jq for JSON parsing." >&2
  exit 1
fi

SINCE="$(date -v -"$DAYS"d +%Y-%m-%d)"

CCJSON="$(ccusage "$SERVICE" daily --json --since "$SINCE" --compact)"

if [ -z "$CCJSON" ]; then
  echo "No usage data for $SERVICE since $SINCE" >&2
  exit 1
fi

TOTAL_COST="$(printf '%s\n' "$CCJSON" | jq -r '.totals.totalCost // 0')"
INPUT_TOKENS="$(printf '%s\n' "$CCJSON" | jq -r '.totals.inputTokens // 0')"
OUTPUT_TOKENS="$(printf '%s\n' "$CCJSON" | jq -r '.totals.outputTokens // 0')"
TOTAL_TOKENS="$(printf '%s\n' "$CCJSON" | jq -r '.totals.totalTokens // 0')"

printf "%s: last %sd totalCost=%s, inputTokens=%s, outputTokens=%s, totalTokens=%s\n" \
  "$SERVICE" "$DAYS" "$TOTAL_COST" "$INPUT_TOKENS" "$OUTPUT_TOKENS" "$TOTAL_TOKENS"

printf "Top models by estimated cost:\n"
printf '%s\n' "$CCJSON" |
  jq -r '.daily[].modelBreakdowns[] | "\(.modelName)\t\(.cost // 0)"' |
  awk '
    {
      if ($1 != "") {
        cost[$1] += $2;
      }
    }
    END {
      for (m in cost) {
        printf "%s\t%.6f\n", m, cost[m];
      }
    }
  ' |
  sort -t$'\t' -k2,2nr

if awk "BEGIN { if ($TOTAL_COST >= $CRITICAL) exit 0; exit 1 }"; then
  echo "[CRITICAL] cost >= $CRITICAL"
  exit 2
fi

if awk "BEGIN { if ($TOTAL_COST >= $WARN) exit 0; exit 1 }"; then
  echo "[WARN] cost >= $WARN"
  exit 1
fi

echo "[OK] under warn $WARN"
